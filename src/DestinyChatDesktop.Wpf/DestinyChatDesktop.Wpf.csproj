<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DestinyChatDesktop</AssemblyName>
    <RootNamespace>DestinyChatDesktop.Wpf</RootNamespace>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DestinyChatDesktop.EmbeddedWinForms\DestinyChatDesktop.EmbeddedWinForms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
